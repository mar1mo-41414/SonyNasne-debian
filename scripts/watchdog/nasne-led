#!/bin/sh
### BEGIN INIT INFO
# Provides:          nasne-led
# Required-Start:    $local_fs nasne-mcu-wd
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: nasne の前面LED(REC=チューナー使用中、LAN=ネットワーク確立で点灯のまま)
### END INIT INFO
# REC(赤)はチューナー使用中に点灯、LAN(橙)はネットワークが確立したら点灯のまま(公式と同じ)。docs/06。
# PWR は、状態ページ(nasne-statusd)が異常を報告している間だけ赤(docs/06)。
# 無効にするなら /etc/default/nasne-led に NASNE_LED_ENABLE=0。NASNE_LED_POLL=秒(既定 0.5)、NASNE_LED_PWR_WARN=0 で「異常でPWR赤」だけ無効。
BIN=/usr/local/sbin/nasne-ledd
LEDCTL=/usr/local/sbin/nasne-ledctl
PIDFILE=/var/run/nasne-led.pid
[ -f /etc/default/nasne-status ] && . /etc/default/nasne-status     # 状態ページのポート(NASNE_STATUS_PORT)を合わせる
[ -f /etc/default/nasne-led ] && . /etc/default/nasne-led
export NASNE_LED_POLL NASNE_LED_PWR_WARN NASNE_LED_WARN_POLL NASNE_STATUS_PORT
case "$1" in
  start)
    [ -x $BIN ] && [ -x $LEDCTL ] || exit 0
    [ "${NASNE_LED_ENABLE:-1}" = 0 ] && exit 0
    [ -f $PIDFILE ] && kill -0 $(cat $PIDFILE) 2>/dev/null && exit 0     # すでに動いている
    nohup $BIN >> /var/log/nasne-led.log 2>&1 &
    echo $! > $PIDFILE
    ;;
  stop)
    [ -f $PIDFILE ] && kill $(cat $PIDFILE) 2>/dev/null     # REC を消灯して終わる(LAN は点灯のまま)
    rm -f $PIDFILE
    ;;
  restart|force-reload) $0 stop; sleep 1; $0 start ;;
  status) [ -f $PIDFILE ] && kill -0 $(cat $PIDFILE) 2>/dev/null && echo running || echo stopped ;;
  *) echo "Usage: $0 {start|stop|restart|status}" >&2; exit 1 ;;
esac
exit 0
