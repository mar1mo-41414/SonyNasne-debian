#!/usr/bin/perl
# nasne-waked — EPGStation の録画予約から「次に起こす時刻」を求めて、ファイルに書いておく常駐プロセス(Debian側。docs/06)。
#   nasne を電源オフ(poweroff)するとき、a-nasne-poweroff がこのファイルを読んで MCU の起床タイマを設定し、
#   次の予約の少し前に自動で電源が入る(公式が予約録画のためにやっているのと同じ)。
# なぜ常駐か: poweroff の最後(rc0.d)はネットワークが落ちたあとで、EPGStation に問い合わせられない。だから、動いている間に定期的に聞いて書いておく。
# 出力: /var/lib/nasne-wake/next  (1行: <起こす時刻 epoch(nasne の時計で)> <最後に問い合わせた時刻 epoch> <次の予約の開始 epoch(EPGStation の時計)> <時計のずれ 秒>。予約が無ければ、起こす時刻=0)
# nasne には RTC が無く、起動直後の時計は古い(NTP で数十秒後に直る)。なので、時刻は EPGStation の応答の Date ヘッダ(正しい時刻)との差で補正して、
# 「nasne の時計で何時に起こすか」を書く。
# 設定: /etc/default/nasne-wake
#   NASNE_WAKE_URL=http://<EPGStationのホスト>:8888   (必須。これが無ければ何もしない)
#   NASNE_WAKE_LEAD=300      予約の開始の何秒前に起こすか(起動に約1〜2分かかる。既定 300)
#   NASNE_WAKE_POLL=300      EPGStation に聞く間隔(秒。既定 300)
#   NASNE_WAKE_ENABLE=0      無効
#   NASNE_WAKE_AUTOOFF=1     (任意。既定 0)タイマ起床で起動した nasne を、使われなくなったら自動で poweroff する(下記)
#   NASNE_WAKE_IDLE=180      自動オフ: 録画・視聴・ssh が、これだけ使われていない状態が続いたら(秒。既定 180)
#   NASNE_WAKE_EPG_MAX=600   自動オフ: Mirakurun の番組表の取得(EPG)だけが動いている間は、ここまで待つ(秒。既定 600。番組表の取得は約10分かかる)。0 なら番組表の取得を待たずに切る
#   NASNE_WAKE_MIRAKURUN_URL=http://<ホスト>:40772   Mirakurun の場所(既定: EPGStation と同じホストの 40772)。チューナーを使っているのが録画・視聴か番組表の取得かを見分けるのに使う
#   NASNE_WAKE_MIN_OFF=600   自動オフ: 次の起床まで、これ以上あくときだけ電源を切る(秒。既定 600。近いなら、起きたままにする)
# EPGStation への問い合わせは GET だけで、何も変更しない。Perl のコアモジュールだけで動く。--once: 1回聞いて結果を表示して終わる(自動オフは判定だけ表示して実行しない)。
#
# 自動オフ(NASNE_WAKE_AUTOOFF=1): 公式は、予約録画のためにタイマ起床したあと、録画が終われば自分で電源を切る。同じことをする。
#   次のすべてを満たしたときだけ poweroff する(手動で電源を入れた・ssh で使っている・視聴中・録画中・予約が近い、のどれかなら、切らない):
#   (1) タイマ起床で起動した(MCUステータス2バイト目のbit1。手動の電源投入では立たない)  (2) 起動から5分以上  (3) チューナーが使われていない
#   (4) ssh のセッションが無い  (5) (3)(4)が IDLE 秒続いた(**番組表の取得は(3)に数えず**、EPG_MAX 秒まで待つ。録画・視聴か番組表の取得かは Mirakurun の
#   /api/tuners で見分ける: 番組表の取得は priority が負のユーザー `Mirakurun:getEPG()`。Mirakurun に繋がらないときは、使用中をすべて録画・視聴として扱う)
#   (6) EPGStation の最新の予約が分かっていて、次の起床まで MIN_OFF 秒以上ある(予約が無ければ、それも可)
use strict; use warnings;
use IO::Socket::INET;
use POSIX qw(strftime);

my $URL   = $ENV{NASNE_WAKE_URL} || '';
my $LEAD  = defined $ENV{NASNE_WAKE_LEAD} && $ENV{NASNE_WAKE_LEAD} ne '' ? $ENV{NASNE_WAKE_LEAD} : 300;
my $POLL  = $ENV{NASNE_WAKE_POLL} || 300;
my $FILE  = $ENV{NASNE_WAKE_FILE} || '/var/lib/nasne-wake/next';
my $ONCE  = (@ARGV && $ARGV[0] eq '--once');
my $AUTOOFF = $ENV{NASNE_WAKE_AUTOOFF} ? 1 : 0;
my $IDLE    = $ENV{NASNE_WAKE_IDLE} || 180;
my $EPG_MAX = defined $ENV{NASNE_WAKE_EPG_MAX} && $ENV{NASNE_WAKE_EPG_MAX} ne '' ? $ENV{NASNE_WAKE_EPG_MAX} : 600;
my $FREE    = $ENV{NASNE_WAKE_FREE} || 60;                                  # 番組表の取得を待つとき、チューナーが完全に空いて、これだけ経ったら取得が終わったとみなす(秒)
my $MIRA    = $ENV{NASNE_WAKE_MIRAKURUN_URL} || ($URL =~ m{^(https?://[^/:]+)} ? "$1:40772" : '');
my $MIN_OFF = defined $ENV{NASNE_WAKE_MIN_OFF} && $ENV{NASNE_WAKE_MIN_OFF} ne '' ? $ENV{NASNE_WAKE_MIN_OFF} : 600;
my $MIN_UP  = $ENV{NASNE_WAKE_MIN_UP} || 300;
my $LOCK    = $ENV{NASNE_RECPT1_LOCK} || '/tmp/nasne-recpt1.lock';
my $LOCKS   = $ENV{NASNE_PROC_LOCKS} || '/proc/locks';
my $TCP     = $ENV{NASNE_PROC_TCP} || '/proc/net/tcp';
my $MCUI2C  = $ENV{NASNE_MCUI2C} || '/usr/local/sbin/mcui2c';
my $POWEROFF = $ENV{NASNE_WAKE_POWEROFF_CMD} || 'poweroff';

sub logmsg { print STDERR strftime('%F %T', localtime) . " nasne-waked: @_\n"; }

# HTTP の Date ヘッダ(例 "Sat, 17 Oct 2026 02:10:11 GMT")を epoch 秒に(モジュール不要)
sub http_date {
    my ($d) = @_;
    my %m = (Jan=>1,Feb=>2,Mar=>3,Apr=>4,May=>5,Jun=>6,Jul=>7,Aug=>8,Sep=>9,Oct=>10,Nov=>11,Dec=>12);
    $d =~ /(\d+) (\w{3}) (\d{4}) (\d+):(\d+):(\d+)/ or return undef;
    my ($day, $mon, $y, $H, $M, $S) = ($1, $m{$2}, $3, $4, $5, $6); return undef unless $mon;
    $y-- if $mon <= 2;
    my $era = int($y / 400); my $yoe = $y - $era * 400;
    my $doy = int((153 * ($mon + ($mon > 2 ? -3 : 9)) + 2) / 5) + $day - 1;
    my $doe = $yoe * 365 + int($yoe / 4) - int($yoe / 100) + $doy;
    return ($era * 146097 + $doe - 719468) * 86400 + $H * 3600 + $M * 60 + $S;
}

# EPGStation の /api/reserves を GET して、(本文, 相手の時刻 epoch)を返す(失敗は undef)
sub http_get {
    my ($host, $port, $path) = @_;
    my $s = IO::Socket::INET->new(PeerAddr => $host, PeerPort => $port, Timeout => 10) or return undef;
    my ($body, $date);
    my $ok = eval {
        local $SIG{ALRM} = sub { die "timeout\n" }; alarm 20;
        print $s "GET $path HTTP/1.0\r\nHost: $host\r\nAccept: application/json\r\nConnection: close\r\n\r\n";
        local $/; my $r = <$s>; alarm 0;
        return 0 unless defined $r && $r =~ /^HTTP\/1\.\d 200 /;
        ($body) = $r =~ /\r\n\r\n(.*)$/s;
        ($date) = $r =~ /^Date:\s*([^\r\n]+)/mi; 1;
    };
    close $s;
    return undef unless $ok && defined $body;
    return ($body, defined $date ? http_date($date) : undef);
}

# 予約の開始時刻(epoch 秒)の一覧。EPGStation の JSON は startAt がミリ秒。JSON モジュールが無いので、startAt を拾う。
# 返り値: (開始時刻の配列への参照, 相手の現在時刻)。問い合わせ失敗は空リスト(予約が無ければ空配列への参照)
sub reserve_starts {
    return () unless $URL =~ m{^https?://([^/:]+)(?::(\d+))?}i;
    my ($host, $port) = ($1, $2 || 80);
    my @all; my $offset = 0; my $srv_now;
    for (1 .. 20) {                                   # 100件ずつ最大2000件
        my ($b, $dt) = http_get($host, $port, "/api/reserves?isHalfWidth=true&limit=100&offset=$offset");
        return () unless defined $b && $b =~ /"reserves"\s*:\s*\[/;
        $srv_now = $dt if defined $dt;
        my @s = $b =~ /"startAt"\s*:\s*(\d{10,13})/g;
        push @all, map { $_ > 99999999999 ? int($_ / 1000) : $_ } @s;
        my ($total) = $b =~ /"total"\s*:\s*(\d+)/;
        $offset += 100;
        last if !defined $total || $offset >= $total;
    }
    return (\@all, $srv_now);
}

sub write_next {
    my ($wake, $polled, $start, $skew) = @_;
    my $dir = $FILE; $dir =~ s{/[^/]*$}{};
    mkdir $dir if length $dir && !-d $dir;
    if (open(my $o, '>', "$FILE.tmp")) { print $o "$wake $polled $start $skew\n"; close $o; rename "$FILE.tmp", $FILE; }
}

sub poll_once {
    my ($starts, $srv_now) = reserve_starts();
    my $now = time;
    if (!defined $starts) { logmsg("EPGStation に問い合わせできない(前回の値を残す)") unless $ONCE; return (undef, undef); }
    my $skew = defined $srv_now ? $srv_now - $now : 0;           # 相手の時計 - 自分の時計(正なら nasne の時計が遅れている)
    my $snow = $now + $skew;                                      # 相手の時計での「いま」
    my @future = sort { $a <=> $b } grep { $_ > $snow } @$starts; # すでに始まった予約は除く
    my ($start, $wake) = (0, 0);
    if (@future) {
        $start = $future[0];
        my $w = $start - $LEAD; $w = $snow + 60 if $w < $snow + 60;   # 近すぎるときは60秒後(電源を切って入れ直す余裕)
        $wake = $w - $skew;                                          # nasne の時計での時刻
    }
    write_next($wake, $now, $start, $skew);
    return ($wake, $start - $skew);
}

if (!$URL) { logmsg("NASNE_WAKE_URL が未設定。何もしない") unless $ONCE; print "NASNE_WAKE_URL 未設定\n" if $ONCE; exit 0; }
# ---- 自動オフの判定 ----
sub uptime_s { my $up = 99999; if (open(my $u, '<', '/proc/uptime')) { my $l = <$u>; close $u; $up = $1 if defined $l && $l =~ /^(\d+)/; } return $up; }

# タイマ起床で起動したか(MCUステータス2バイト目のbit1)。読めなければ undef
sub timer_boot {
    my $o = `$MCUI2C r 20 6 2>/dev/null`;
    return undef unless defined $o && $o =~ /data=[0-9a-f]{2} ([0-9a-f]{2}) /i;
    return (hex($1) & 0x02) ? 1 : 0;
}

# チューナーの排他ロックを nasne-recpt1 が持っているか(nasne-ledd と同じ判定。/proc/locks を読むだけ)
sub tuner_busy {
    my @st = stat($LOCK) or return 0;
    my $ino = $st[1];
    open(my $h, '<', $LOCKS) or return 0;
    while (my $l = <$h>) { return 1 if $l =~ /\bFLOCK\b/ && $l =~ /\s[0-9a-f]+:[0-9a-f]+:$ino\s/; }
    return 0;
}

# チューナーを使っているのが「番組表の取得だけ」か。返り値: 'epg'(Mirakurun のユーザーが全員 priority<0)、'real'(録画・視聴、または分からない)
sub busy_class {
    return 'real' unless $MIRA =~ m{^https?://([^/:]+)(?::(\d+))?}i;
    my ($body) = http_get($1, $2 || 80, "/api/tuners");
    return 'real' unless defined $body && $body =~ /"users"\s*:\s*\[/;
    my @p = $body =~ /"priority"\s*:\s*(-?\d+)/g;
    return 'real' unless @p;                           # ローカルでは使用中なのに、Mirakurun のユーザーがいない(別の経路で使われている)
    return (grep { $_ >= 0 } @p) ? 'real' : 'epg';
}

# ssh(ポート22)で繋がっているセッションがあるか(/proc/net/tcp の ESTABLISHED=01、ローカルポート 0016)
sub ssh_active {
    open(my $h, '<', $TCP) or return 0;
    <$h>;
    while (my $l = <$h>) { my @f = split ' ', $l; return 1 if @f > 3 && $f[1] =~ /:0016$/ && $f[3] eq '01'; }
    return 0;
}

# 電源を切ってよいか。返り値: (1/0, 理由)
sub autooff_decide {
    my ($timer, $real_idle, $any_idle, $cls, $wake, $polled_ago) = @_;     # real_idle=録画・視聴・ssh が無い秒数、any_idle=チューナー自体が空いている秒数、cls='real'|'epg'|'free'
    return (0, "タイマ起床で起動していない(手動の電源投入)") unless $timer;
    return (0, "起動から " . uptime_s() . " 秒(${MIN_UP}秒未満)") if uptime_s() < $MIN_UP;
    return (0, "チューナーを使用中(録画・視聴)") if $cls eq 'real';
    return (0, "ssh のセッションがある") if ssh_active();
    return (0, "録画・視聴・ssh の終了から ${real_idle} 秒(${IDLE}秒未満)") if $real_idle < $IDLE;
    if ($EPG_MAX > 0) {
        if ($cls eq 'epg' && $real_idle < $IDLE + $EPG_MAX) { my $w = $IDLE + $EPG_MAX - $real_idle; return (0, "番組表の取得中(最長あと ${w} 秒待つ)"); }
        return (0, "番組表の取得の終了を待つ(チューナーが空いてから ${any_idle} 秒、${FREE}秒未満)") if $cls eq 'free' && $any_idle < $FREE;
    }
    return (0, "EPGStation の予約が確認できていない") if !defined $polled_ago || $polled_ago > 3 * $POLL + 60;
    if ($wake) { my $gap = $wake - time; return (0, "次の起床まで ${gap} 秒(${MIN_OFF}秒未満)。起きたままにする") if $gap < $MIN_OFF; }
    return (1, $wake ? "次の起床 " . strftime('%F %T', localtime $wake) . " まで電源を切る" : "予約なし。電源を切る");
}

if ($ONCE) {
    my ($wake, $start) = poll_once();
    if (!defined $wake) { print "問い合わせ失敗\n"; exit 1; }
    print $wake ? "次の予約: " . strftime('%F %T', localtime $start) . " / 起こす時刻: " . strftime('%F %T', localtime $wake) . " (nasne の時計で)\n" : "予約なし\n";
    if ($AUTOOFF) {
        my $t = timer_boot(); my $cls = tuner_busy() ? busy_class() : 'free';
        my ($ok, $why) = autooff_decide($t, $IDLE, $FREE, $cls, $wake, 0);
        print "自動オフ: " . ($ok ? "切る" : "切らない") . " — $why (タイマ起床=" . (defined $t ? $t : '不明') . "、チューナー=$cls)\n";
    }
    exit 0;
}
logmsg("開始 url=$URL lead=${LEAD}s poll=${POLL}s autooff=" . ($AUTOOFF ? "on idle=${IDLE}s epg_max=${EPG_MAX}s min_off=${MIN_OFF}s mirakurun=$MIRA" : "off"));

my $last = '';
my ($wake, $start, $polled_up) = (0, 0, undef);       # polled_up: 最後に問い合わせが成功したときの uptime
my $next_poll_up = 0;
my $timer = undef;                                      # タイマ起床か(読めるまで undef)
my $last_real = uptime_s();                             # 録画・視聴・ssh を最後に見た時点の uptime(時計がステップしても狂わないよう、uptime で測る)
my $last_any  = $last_real;                             # チューナーが(番組表の取得を含めて)使われているのを最後に見た時点
my $why_last = '';
while (1) {
    my $up = uptime_s();
    if ($up >= $next_poll_up) {
        my ($w, $st) = poll_once();
        if (defined $w) {
            ($wake, $start, $polled_up) = ($w, $st, $up);
            my $msg = $wake ? "次の予約 " . strftime('%F %T', localtime $start) . "、起こす時刻 " . strftime('%F %T', localtime $wake) . " (nasne の時計で)" : "予約なし";
            if ($msg ne $last) { logmsg($msg); $last = $msg; }
        }
        # 起動直後は時計がまだ直っていない可能性があるので、最初の10分は60秒ごとに聞き直す
        $next_poll_up = $up + ($up < 600 && $POLL > 60 ? 60 : $POLL);
    }
    if ($AUTOOFF) {
        $timer = timer_boot() unless defined $timer;
        my $busy = tuner_busy(); my $cls = $busy ? busy_class() : 'free';
        $last_any = $up if $busy;
        $last_real = $up if $cls eq 'real' || ssh_active();
        my ($ok, $why) = autooff_decide($timer, $up - $last_real, $up - $last_any, $cls, $wake, defined $polled_up ? $up - $polled_up : undef);
        if ($why ne $why_last && $why !~ /^(録画・視聴・ssh の終了から|番組表の取得)/) { logmsg("自動オフ: " . ($ok ? "切る条件がそろった" : "切らない") . " — $why"); $why_last = $why; }
        if ($ok) {
            # 切る直前に、予約をもう一度聞いて確かめる(直前に追加された予約を見逃さない)
            my ($w, $st) = poll_once();
            if (defined $w) { ($wake, $start, $polled_up) = ($w, $st, $up); ($ok, $why) = autooff_decide($timer, $up - $last_real, $up - $last_any, $cls, $wake, 0); }
            if ($ok) { logmsg("自動オフ: poweroff する ($why)"); system('logger', '-t', 'nasne-waked', "自動オフ: poweroff ($why)"); system($POWEROFF); sleep 120; }
        }
    }
    sleep 10;
}
