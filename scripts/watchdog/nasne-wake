#!/bin/sh
### BEGIN INIT INFO
# Provides:          nasne-wake
# Required-Start:    $local_fs $network nasne-mcu-wd
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: EPGStation の録画予約に合わせて、電源オフ中の nasne を起こす(次の起床時刻を求めて書いておく)
### END INIT INFO
# nasne-waked(常駐)が EPGStation の予約を定期的に読み、次に起こす時刻を /var/lib/nasne-wake/next に書く。
# poweroff のとき a-nasne-poweroff がそれを読んで、MCUの起床タイマをセットする(docs/06)。
# 設定は /etc/default/nasne-wake (NASNE_WAKE_URL=http://<EPGStation>:8888 が必須。無ければ何もしない):
#   NASNE_WAKE_URL  NASNE_WAKE_LEAD=300(予約の何秒前に起こすか)  NASNE_WAKE_POLL=300(問い合わせ間隔)  NASNE_WAKE_ENABLE=0(無効)
#   NASNE_WAKE_AUTOOFF=1(タイマ起床で起動したあと、使われなくなったら自動で poweroff。既定は無効)  NASNE_WAKE_IDLE=600  NASNE_WAKE_MIN_OFF=600
BIN=/usr/local/sbin/nasne-waked
PIDFILE=/var/run/nasne-wake.pid
[ -f /etc/default/nasne-wake ] && . /etc/default/nasne-wake
export NASNE_WAKE_URL NASNE_WAKE_LEAD NASNE_WAKE_POLL NASNE_WAKE_AUTOOFF NASNE_WAKE_IDLE NASNE_WAKE_MIN_OFF
case "$1" in
  start)
    [ -x $BIN ] || exit 0
    [ "${NASNE_WAKE_ENABLE:-1}" = 0 ] && exit 0
    [ -n "$NASNE_WAKE_URL" ] || exit 0
    [ -f $PIDFILE ] && kill -0 $(cat $PIDFILE) 2>/dev/null && exit 0
    nohup $BIN >> /var/log/nasne-wake.log 2>&1 &
    echo $! > $PIDFILE
    ;;
  stop)
    [ -f $PIDFILE ] && kill $(cat $PIDFILE) 2>/dev/null
    rm -f $PIDFILE
    ;;
  restart|force-reload) $0 stop; sleep 1; $0 start ;;
  status) [ -f $PIDFILE ] && kill -0 $(cat $PIDFILE) 2>/dev/null && echo running || echo stopped ;;
  *) echo "Usage: $0 {start|stop|restart|status}" >&2; exit 1 ;;
esac
exit 0
