 c.push(card('チューナー・MCU',[row('チューナー',s.tuner.available?(s.tuner.busy?'使用中':'空き'):'応答なし'),row('ウォッチドッグ',s.mcu.available?(s.mcu.watchdog_disabled?'停止中(正常)':'動作中'):'—'),row('タイマー起動',s.mcu.available?(s.mcu.timer_wake_boot?'はい':'いいえ'):'—')]));
