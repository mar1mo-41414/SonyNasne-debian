 c.push(card('HDD',[row('機種',f(h.model)),row('温度',h.temperature_c!=null?h.temperature_c+' ℃':'—'),row('SMART',f(h.health)+(h.standby?'(待機中・前回値)':'')),row('通電時間',h.power_on_hours!=null?h.power_on_hours+' 時間':'—'),row('代替 / 保留セクタ',f(h.reallocated_sectors)+' / '+f(h.pending_sectors))]));
