sub respond {
    my ($c, $code, $type, $body, $head) = @_;
    my %t = (200 => 'OK', 404 => 'Not Found', 405 => 'Method Not Allowed');
    utf8::encode($body) if utf8::is_utf8($body);
    print $c "HTTP/1.0 $code $t{$code}\r\nContent-Type: $type\r\nContent-Length: " . length($body) . "\r\nCache-Control: no-store\r\nAccess-Control-Allow-Origin: *\r\nConnection: close\r\n\r\n";
    print $c $body unless $head;
}

sub handle {
    my ($c) = @_;
    $c->autoflush(1);
    my $req = '';
    eval { local $SIG{ALRM} = sub { die "t\n" }; alarm 5; while (defined(my $l = <$c>)) { $req = $l unless length $req; last if $l =~ /^\r?\n$/; } alarm 0; 1 } or return;
    my ($method, $path) = $req =~ m{^(\w+)\s+(\S+)};
    return respond($c, 405, 'text/plain; charset=utf-8', "method not allowed\n") unless $method && $method =~ /^(GET|HEAD)$/;
    my $head = $method eq 'HEAD';
    $path =~ s/\?.*//;
    if    ($path eq '/' || $path eq '/index.html') { respond($c, 200, 'text/html; charset=utf-8', $HTML, $head); }
    elsif ($path eq '/status.json') { respond($c, 200, 'application/json; charset=utf-8', jenc(gather()) . "\n", $head); }
    elsif ($path eq '/metrics')     { respond($c, 200, 'text/plain; version=0.0.4; charset=utf-8', metrics(gather()), $head); }
    elsif ($path eq '/healthz')     { respond($c, 200, 'text/plain; charset=utf-8', "ok\n", $head); }
    else                            { respond($c, 404, 'text/plain; charset=utf-8', "not found\n", $head); }
}

# ---- 起動 ----
if (@ARGV && $ARGV[0] eq '--once') { $ONCE = 1; print jenc(gather()), "\n"; exit 0; }
$SIG{PIPE} = 'IGNORE';
my $srv = IO::Socket::INET->new(Listen => 8, LocalAddr => $BIND, LocalPort => $PORT, ReuseAddr => 1, Proto => 'tcp') or die "listen $BIND:$PORT: $!\n";
print STDERR strftime('%F %T', localtime) . " nasne-statusd listening on $BIND:$PORT\n";
# 1プロセスで順に処理する(SMARTの結果を使い回すため。読み取りが遅いクライアントは5秒で切る)
while (1) {
    my $c = $srv->accept or next;
    eval { handle($c); 1 };
    close $c;
}
