#!/bin/sh
### BEGIN INIT INFO
# Provides:          nasne-mcu-wd
# Required-Start:    $local_fs nasne-xcode4drv
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:
# Short-Description: (6.12 版)MCU のウォッチドッグの確認。実際に止めるのはカーネルの nasne-mcu ドライバ
### END INIT INFO
# Debian 11(自作カーネル 2.6.29)版の nasne-mcu-wd は、xcode4drv の I2C で、MCU のウォッチドッグを止めて PWR LED を点灯していた。
# 6.12 では、これをカーネルの nasne-mcu ドライバが起動時に済ませる。このスクリプトは、他のサービスの「Required-Start: nasne-mcu-wd」
# (=ドライバが読み込まれ、MCU に届く状態)を満たすためのもので、念のためウォッチドッグが止まっているか(ステータスの2バイト目の bit7)を確認して、
# 止まっていなければ止める。
D=/sys/bus/i2c/devices/0-0010
LOG=/var/log/nasne-mcu-wd.log
case "$1" in
  start)
    echo "== $(date) start" >> $LOG
    set -- $(cat $D/status 2>/dev/null)
    if [ -z "$2" ]; then echo "MCU のステータスが読めない" >> $LOG; exit 0; fi
    if [ $((0x$2 & 0x80)) -ne 0 ]; then
        echo "ウォッチドッグは停止済み(status b1=$2)" >> $LOG
    else
        echo "20 01" > $D/raw && echo "ウォッチドッグを止めた" >> $LOG
    fi
    ;;
  stop|restart|force-reload|status) : ;;
  *) echo "Usage: $0 start" >&2; exit 1 ;;
esac
exit 0
