#!/bin/sh
# ネットワークが上がったら時刻を合わせる(nasne には RTC が無く、起動直後は fake-hwclock が戻した、電源を切った時点の時刻)。/etc/network/if-up.d/nasne-time に置く。
# 時刻に依存するもの: nasne-waked(起こす時刻)、録画のファイル名、apt の証明、ログ。fake-hwclock は、終了時の時刻を保存して起動時に戻す(1970 年よりまし)。
# (ntpdate コマンドは ntpdig を呼ぶが、カーネルに IPv6 が無いので、-4 で IPv4 に限る)
# 注意: if-up.d は、起動中に複数回(eth0 の up、ほかの経路)呼ばれることがある。ntpdig -S は、測ったずれの分だけ時計を進める(段階的修正)ので、
#   同時に2つ走ると、どちらも同じずれを測って、2回進める(7分遅れていたら、正しい時刻になったあと、さらに7分進む)。
#   なので、flock で必ず1つずつ走らせる(あとから走るものは、すでに合っているので、ずれ≒0 で何もしない)。
[ "$IFACE" = "lo" ] && exit 0
SERVER=${NASNE_NTP_SERVER:-ntp.nict.jp}
(
  flock -w 120 9 || exit 0
  for i in 1 2 3; do ntpdig -S -4 "$SERVER" >>/var/log/nasne-time.log 2>&1 && break; sleep 5; done
) 9>/run/nasne-time.lock &
exit 0
