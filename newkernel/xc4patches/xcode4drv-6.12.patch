+    if (IS_ERR(xc_pdev))
+        return PTR_ERR(xc_pdev);
+    dma_set_mask_and_coherent(&xc_pdev->dev, DMA_BIT_MASK(32));
+    xc_dma_dev = &xc_pdev->dev;
