+/*
+ * 6.12 移植: ファーム(メディアエンジン)が基板の電源を入れる前にバスが Low だったため、I2C ブロック1のマスターが「バスビジー」の状態に張り付いて、
+ * 復調 IC が全く ACK しない(rv=0x0e)ことがある。PPC ブロックのソフトリセット(PPC_SFT_RSTN の bit0 を一度落とす)で、マスターが戻る。
+ * 起動の最後(電源が安定した後)に、ビジーが立っていれば1回だけ行う。元のドライバの PPC_Soft_Reset は、XC_SOC_BUILD では何もしない。
+ */
+static void xc_i2c_unwedge(PXCODEDEV pXcode)
+{
+    uint32 cmd1 = 0, v = 0;
+
+    msleep(500);
+    if (MMR_READ_CHECK(pXcode, &cmd1, XC_I2C1_COMMAND) == RET_NODEVICE)
+        return;
+    if (!(cmd1 & XC_I2C1_COMMAND_BUS_BUSY_MASK))
+        return;
+    printk(KERN_INFO "xcode4drv: I2C1 がバスビジーのまま(0x%08x)。PPC をソフトリセットして復帰させる\n", cmd1);
+    if (MMR_READ_CHECK(pXcode, &v, XC_PPC_SFT_RSTN) == RET_NODEVICE)
+        return;
+    MMR_WRITE_CHECK(pXcode, XC_PPC_SFT_RSTN, v & ~XC_PPC_SFT_RSTN_PPC_SFT_RSTN_MASK);
+    msleep(1);
+    MMR_WRITE_CHECK(pXcode, XC_PPC_SFT_RSTN, v | XC_PPC_SFT_RSTN_PPC_SFT_RSTN_MASK);
+    msleep(100);
+}
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(2, 6, 0)
 int xcode_init_module(void)
 #else
 int32 init_module(void)
 #endif
 {
