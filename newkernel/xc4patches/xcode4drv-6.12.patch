+#ifdef LINUX
+/*
+ * 6.12 のタイマーは、コールバックに struct timer_list * を渡し、data メンバーが無い。元のドライバは (関数, data=pXcode) を渡すので、
+ * タイマーのアドレスから (関数, data) を引く小さな表を持つ(タイマーは pXcode の中に埋め込まれていて、数は少ない)。
+ */
+struct xc_timer_ent {
+    struct timer_list *t;
+    void (*fn)(unsigned long);
+    unsigned long data;
+};
+static struct xc_timer_ent xc_timer_tab[32];
+static DEFINE_SPINLOCK(xc_timer_lock);
+
+static void xc_timer_cb(struct timer_list *t)
+{
+    void (*fn)(unsigned long) = NULL;
+    unsigned long data = 0;
+    unsigned long fl;
+    int i;
+
+    spin_lock_irqsave(&xc_timer_lock, fl);
+    for (i = 0; i < ARRAY_SIZE(xc_timer_tab); i++)
+        if (xc_timer_tab[i].t == t) { fn = xc_timer_tab[i].fn; data = xc_timer_tab[i].data; break; }
+    spin_unlock_irqrestore(&xc_timer_lock, fl);
+    if (fn)
+        fn(data);
+}
+
+void xc_timer_start(struct timer_list *t, void (*fn)(unsigned long), unsigned long data, unsigned long expires)
+{
+    unsigned long fl;
+    int i, free = -1;
+
+    spin_lock_irqsave(&xc_timer_lock, fl);
+    for (i = 0; i < ARRAY_SIZE(xc_timer_tab); i++) {
+        if (xc_timer_tab[i].t == t) { free = i; break; }
+        if (free < 0 && !xc_timer_tab[i].t) free = i;
+    }
+    if (free >= 0) {
+        xc_timer_tab[free].t = t; xc_timer_tab[free].fn = fn; xc_timer_tab[free].data = data;
+    }
+    spin_unlock_irqrestore(&xc_timer_lock, fl);
+    timer_setup(t, xc_timer_cb, 0);
+    t->expires = expires;
+    add_timer(t);
+}
+#endif
